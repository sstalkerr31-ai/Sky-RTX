#pragma code_page(65001)
#include <winver.h>
#include "../layer/skyrt_version.h"
// everything the one-file installer carries
1 ICON "res\\icon.ico"
101 RCDATA "build\\SkyRT.dll"
102 RCDATA "..\\layer\\VK_LAYER_SKYRT.json"
201 RCDATA "res\\hello.png"
202 RCDATA "res\\think.png"
203 RCDATA "res\\shock.png"
204 RCDATA "res\\cover.png"
205 RCDATA "res\\laugh.png"
206 RCDATA "res\\dust.png"
207 RCDATA "res\\serious.png"
208 RCDATA "res\\guilty.png"
209 RCDATA "res\\run.png"
210 RCDATA "res\\joy.png"

// file properties: who made it and what it is (an exe without them looks more suspicious to antivirus heuristics)
VS_VERSION_INFO VERSIONINFO
FILEVERSION SKYRT_VERSION_NUM
PRODUCTVERSION SKYRT_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "Stalker 31"
            VALUE "FileDescription", "SkyRT: установка, настройка и запуск лучей в Sky"
            VALUE "FileVersion", SKYRT_VERSION_STR
            VALUE "InternalName", "SkyRT_Setup"
            VALUE "LegalCopyright", "MIT License, Stalker 31. github.com/sstalkerr31-ai/Sky-RTX"
            VALUE "OriginalFilename", "SkyRT_Setup.exe"
            VALUE "ProductName", "SkyRT"
            VALUE "ProductVersion", SKYRT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
